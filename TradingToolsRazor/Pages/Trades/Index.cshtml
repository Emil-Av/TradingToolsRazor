@page
@model TradingToolsRazor.Pages.Trades.IndexModel
@using SharedEnums.Enums
@using global::Shared
@{
    ViewData["Title"] = "Paper Trades";
}

@if (Model.TradesVM.CurrentTrade != null)
{
    <input type="hidden" value="@Model.TradesVM.CurrentTrade.Id" id="spanTradeIdInput" />
    <input type="hidden" value="@Model.TradesVM.CurrentTrade.JournalId" id="spanJournalIdInput" />
    <input type="hidden" value="@Model.TradesVM.CurrentTrade.SampleSizeId" id="spanSampleSizeIdInput" />
    <input type="hidden" value="@Model.TradesVM.CurrentSampleSize.ReviewId" id="spanReviewIdInput" />
}

<div class="row justify-content-center align-items-top">
    <div class="col-10 text-center">
        <h2>
            @if (!string.IsNullOrEmpty(Model.TradesVM.ErrorMsg))
            {
                <script>
                    toastr.error('@Html.Raw(Model.TradesVM.ErrorMsg)');
                </script>
            }
            @(Model.TradesVM.CurrentTrade != null ? "Paper Trades" : "No Paper Trades Yet")
        </h2>

        <!-- Dropdown Menus -->
        <div class="container mb-4">
            <div class="row justify-content-center">
                <div class="col-12 col-md-auto d-flex align-items-center flex-wrap justify-content-center">
                    @await Html.PartialAsync("_TradesMenuDropdowns")
                </div>
            </div>
        </div>

        <!-- Screenshots Carousel -->
        <div class="row justify-content-center">
            <div class="col-10">
                <div id="carouselTrades" class="carousel slide" data-bs-ride="false">
                    <div id="imageContainer">
                        <div class="carousel-indicators">
                            @for (int i = 0; i < Model.TradesVM.CurrentTrade.ScreenshotsUrls.Count; i++)
                            {
                                <button type="button" data-bs-target="#carouselTrades" data-bs-slide-to="@i" class="@(i == 0 ? "active" : "")" aria-current="@(i == 0 ? "true" : "false")" aria-label="Slide @(i + 1)"></button>
                            }
                        </div>
                        <div class="carousel-inner">
                            @for (int i = 0; i < Model.TradesVM.CurrentTrade.ScreenshotsUrls.Count; i++)
                            {
                                <div class="carousel-item @(i == 0 ? "active" : "")">
                                    <img src="@Model.TradesVM.CurrentTrade.ScreenshotsUrls[i]" class="d-block w-100" alt="Trade screenshot @(i + 1)">
                                </div>
                            }
                        </div>
                    </div>
                    <button class="carousel-control-prev" type="button" data-bs-target="#carouselTrades" data-bs-slide="prev">
                        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Previous</span>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#carouselTrades" data-bs-slide="next">
                        <span class="carousel-control-next-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Next</span>
                    </button>
                </div>
            </div>
        </div>

        <!-- Trade Details Card -->
        <div class="row justify-content-center mt-3">
            <div class="col-10 text-center">
                <div class="card shadow mb-4">

                    <!-- Card Header -->
                    <div class="card-header py-3">
                        <div class="row align-items-center">
                            <div class="col-auto">
                                <div class="dropdown">
                                    <a class="dropdown-toggle" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <span id="currentMenu" class="min-width-60">Trade Data</span>
                                    </a>
                                    <ul class="dropdown-menu" id="headerMenu">
                                        <li><a class="dropdown-item bg-gray-400" role="button" id="itemTradingData">Trade Data</a></li>
                                        <li><a class="dropdown-item" role="button" id="itemJournal">Journal</a></li>
                                        <li><a class="dropdown-item" role="button" id="itemReview">Review</a></li>
                                    </ul>
                                </div>
                            </div>

                            <!-- Tab Headers -->
                            <div class="col mr-md-5 d-flex justify-content-center">

                                <!-- Trade Data Tab Header -->
                                <div id="tradeDataTabHeaders">
                                    <ul class="nav nav-tabs" role="tablist">
                                        <li class="nav-item" role="presentation">
                                            <button class="nav-link active" id="tradeData-tab" data-bs-toggle="tab" data-bs-target="#tradeData" type="button" role="tab" aria-controls="tradeData" aria-selected="true">Trade Data</button>
                                        </li>
                                    </ul>
                                </div>

                                <!-- Journal Tab Headers -->
                                <div id="journalTabHeaders" class="d-none">
                                    <ul class="nav nav-tabs" role="tablist">
                                        <li class="nav-item" role="presentation">
                                            <button class="nav-link active" id="pre-tab" data-bs-toggle="tab" data-bs-target="#pre" type="button" role="tab" aria-controls="pre" aria-selected="true">Pre</button>
                                        </li>
                                        <li class="nav-item" role="presentation">
                                            <button class="nav-link" id="during-tab" data-bs-toggle="tab" data-bs-target="#during" type="button" role="tab" aria-controls="during" aria-selected="false">During</button>
                                        </li>
                                        <li class="nav-item" role="presentation">
                                            <button class="nav-link" id="exit-tab" data-bs-toggle="tab" data-bs-target="#exit" type="button" role="tab" aria-controls="exit" aria-selected="false">Exit</button>
                                        </li>
                                        <li class="nav-item" role="presentation">
                                            <button class="nav-link" id="post-tab" data-bs-toggle="tab" data-bs-target="#post" type="button" role="tab" aria-controls="post" aria-selected="false">Post</button>
                                        </li>
                                    </ul>
                                </div>

                                <!-- Review Tab Headers -->
                                <div id="reviewTabHeaders" class="d-none">
                                    <ul class="nav nav-tabs" role="tablist">
                                        <li class="nav-item" role="presentation">
                                            <button class="nav-link active" id="first-tab" data-bs-toggle="tab" data-bs-target="#first" type="button" role="tab" aria-controls="first" aria-selected="true">First</button>
                                        </li>
                                        <li class="nav-item" role="presentation">
                                            <button class="nav-link" id="second-tab" data-bs-toggle="tab" data-bs-target="#second" type="button" role="tab" aria-controls="second" aria-selected="false">Second</button>
                                        </li>
                                        <li class="nav-item" role="presentation">
                                            <button class="nav-link" id="third-tab" data-bs-toggle="tab" data-bs-target="#third" type="button" role="tab" aria-controls="third" aria-selected="false">Third</button>
                                        </li>
                                        <li class="nav-item" role="presentation">
                                            <button class="nav-link" id="forth-tab" data-bs-toggle="tab" data-bs-target="#forth" type="button" role="tab" aria-controls="forth" aria-selected="false">Forth</button>
                                        </li>
                                        <li class="nav-item" role="presentation">
                                            <button class="nav-link" id="summary-tab" data-bs-toggle="tab" data-bs-target="#summary" type="button" role="tab" aria-controls="summary" aria-selected="false">Summary</button>
                                        </li>
                                    </ul>
                                </div>

                            </div>
                        </div>
                    </div>

                    <!-- Card Body -->
                    <div class="card-body" id="cardBody">

                        <!-- Trade Data Content -->
                        <div id="tradeDataTabContent">
                            <div class="row">
                                <div class="col">
                                    <partial name="_TradeData" model="Model.TradesVM" />
                                </div>
                            </div>
                        </div>

                        <!-- Journal Content -->
                        <div id="journalTabContent" class="d-none">
                            <div class="tab-content">
                                <div class="tab-pane fade show active tundora text-start" id="pre" role="tabpanel" aria-labelledby="pre-tab">
                                    @Html.Raw(Model.TradesVM.CurrentTrade.Journal.Pre)
                                </div>
                                <div class="tab-pane fade tundora text-start" id="during" role="tabpanel" aria-labelledby="during-tab">
                                    @Html.Raw(Model.TradesVM.CurrentTrade.Journal.During)
                                </div>
                                <div class="tab-pane fade tundora text-start" id="exit" role="tabpanel" aria-labelledby="exit-tab">
                                    @Html.Raw(Model.TradesVM.CurrentTrade.Journal.Exit)
                                </div>
                                <div class="tab-pane fade tundora text-start" id="post" role="tabpanel" aria-labelledby="post-tab">
                                    @(Model.TradesVM.CurrentTrade.Journal.Post == null ? "Double click to add text" : Html.Raw(Model.TradesVM.CurrentTrade.Journal.Post))
                                </div>
                            </div>
                        </div>

                        <!-- Review Content -->
                        <div id="reviewTabContent" class="d-none">
                            <div class="tab-content">
                                <div class="tab-pane fade show active tundora text-start" id="first" role="tabpanel" aria-labelledby="first-tab">
                                    @Html.Raw(Model.TradesVM!.CurrentSampleSize!.Review!.First)
                                </div>
                                <div class="tab-pane fade tundora text-start" id="second" role="tabpanel" aria-labelledby="second-tab">
                                    @Html.Raw(Model.TradesVM.CurrentSampleSize.Review.Second)
                                </div>
                                <div class="tab-pane fade tundora text-start" id="third" role="tabpanel" aria-labelledby="third-tab">
                                    @Html.Raw(Model.TradesVM.CurrentSampleSize.Review.Third)
                                </div>
                                <div class="tab-pane fade tundora text-start" id="forth" role="tabpanel" aria-labelledby="forth-tab">
                                    @Html.Raw(Model.TradesVM.CurrentSampleSize.Review.Forth)
                                </div>
                                <div class="tab-pane fade tundora text-start" id="summary" role="tabpanel" aria-labelledby="summary-tab">
                                    @Html.Raw(Model.TradesVM.CurrentSampleSize.Review.Summary)
                                </div>
                            </div>
                        </div>

                        <div id="summernote" class="d-none"></div>

                    </div>

                    <!-- Card Footer -->
                    <div class="card-footer d-flex justify-content-start mt-2">
                        <div id="journalButtons">
                            <button class="btn btn-info ms-1" id="btnUpdate" type="button">
                                <i class="fa-regular fa-floppy-disk me-2"></i>Update
                            </button>
                            <button class="btn btn-primary d-none" id="btnEdit" type="button">
                                <i class="fa-solid fa-pen-to-square me-2"></i>Edit
                            </button>
                            <button class="btn btn-primary d-none editorOnBtns" id="btnSave" type="button">
                                <i class="fa-regular fa-floppy-disk me-2"></i>Save
                            </button>
                            <button class="btn btn-secondary d-none editorOnBtns" id="btnCancel" type="button">
                                <i class="fa-solid fa-xmark me-2"></i>Cancel
                            </button>
                        </div>
                    </div>

                </div>
            </div>
        </div>


    </div>
</div>

@section Scripts {
    <script src="~/js/trades.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/summernote@0.8.18/dist/summernote.min.js"></script>
}