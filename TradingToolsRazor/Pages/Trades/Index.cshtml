@page
@model TradingToolsRazor.Pages.Trades.IndexModel
@using SharedEnums.Enums
@using global::Shared
@{
    ViewData["Title"] = "Paper Trades";
}

@if (Model.TradesVM.CurrentTrade != null)
{
    <input type="hidden" value="@Model.TradesVM.CurrentTrade.Id" id="spanTradeIdInput" />
    <input type="hidden" value="@Model.TradesVM.CurrentTrade.JournalId" id="spanJournalIdInput" />
    <input type="hidden" value="@Model.TradesVM.CurrentTrade.SampleSizeId" id="spanSampleSizeIdInput" />
    <input type="hidden" value="@Model.TradesVM.CurrentSampleSize.ReviewId" id="spanReviewIdInput" />
}

<div class="row justify-content-center align-items-top">
    <div class="col-10 text-center">
        <h2>
            @if (!string.IsNullOrEmpty(Model.TradesVM.ErrorMsg))
            {
                <script>
                    toastr.error('@Html.Raw(Model.TradesVM.ErrorMsg)');
                </script>
            }
            @(Model.TradesVM.CurrentTrade is not null ? "Trades" : "No Trades Yet")
        </h2>

        @if (Model.TradesVM.CurrentTrade is not null)
        {
            @await Html.PartialAsync("_TradesMenuDropdowns")

            @await Html.PartialAsync("_TradesCarousel")

            @await Html.PartialAsync("_TradeDetailsCard")
        }
    </div>
</div>

@section Scripts {
    <script src="~/js/trades.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/summernote@0.8.18/dist/summernote.min.js"></script>
}