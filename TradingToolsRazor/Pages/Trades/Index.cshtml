@page
@model TradingToolsRazor.Pages.Trades.IndexModel
@using SharedEnums.Enums
@using global::Shared
@using System.Text.Json
@{
    ViewData["Title"] = "Trades";
}

@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery

<input type="hidden" id="__RequestVerificationToken" value="@(Antiforgery.GetAndStoreTokens(HttpContext).RequestToken)" />

<div class="row justify-content-center align-items-top">
    <div class="col-10 text-center">
        <h2>
            @if (!string.IsNullOrEmpty(Model.TradesVM.ErrorMsg))
            {
                <script>
                    toastr.error('@Html.Raw(Model.TradesVM.ErrorMsg)');
                </script>
            }
            @(Model.TradesVM.CurrentTrade is not null ? "Trades" : "No Trades Yet")
        </h2>

        @if (Model.TradesVM.CurrentTrade is not null)
        {
            @await Html.PartialAsync("_TradesMenuDropdowns")

            @await Html.PartialAsync("_TradesCarousel")

            @await Html.PartialAsync("_TradeDetailsCard")
        }
    </div>
</div>

@section Scripts {
    @if (Model.TradesVM.CurrentTrade is not null)
    {
        <script>
            window.tradeData = @Html.Raw(JsonSerializer.Serialize(new {
                tradeId = Model.TradesVM.CurrentTrade.Id,
                journalId = Model.TradesVM.CurrentTrade.JournalId,
                screenshotsUrls = Model.TradesVM.CurrentTrade.ScreenshotsUrls,
                sampleSizeId = Model.TradesVM.CurrentTrade.SampleSizeId,
                reviewId = Model.TradesVM.CurrentSampleSize.ReviewId
            }));
        </script>
    }
    <script src="~/js/trades.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/summernote@0.8.18/dist/summernote.min.js"></script>
}