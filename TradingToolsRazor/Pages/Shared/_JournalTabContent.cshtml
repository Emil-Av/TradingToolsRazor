@model Models.ViewModels.TradesVM

<div id="journalTabContent" class="d-none">
    <div class="tab-content">
        <div class="tab-pane fade tundora text-start" id="pre" data-journal-data="Pre" role="tabpanel" aria-labelledby="pre-tab">
            @Html.Raw(Model.CurrentTrade!.Journal!.Pre)
        </div>
        <div class="tab-pane fade tundora text-start" id="during" role="tabpanel" data-journal-data="During" aria-labelledby="during-tab">
            @Html.Raw(Model.CurrentTrade.Journal.During)
        </div>
        <div class="tab-pane fade tundora text-start" id="exit" role="tabpanel" data-journal-data="Exit" aria-labelledby="exit-tab">
            @Html.Raw(Model.CurrentTrade.Journal.Exit )
        </div>
        <div class="tab-pane fade tundora text-start" id="post" role="tabpanel" data-journal-data="Post" aria-labelledby="post-tab">
            @Html.Raw(Model.CurrentTrade.Journal.Post)
        </div>
    </div>
</div>
