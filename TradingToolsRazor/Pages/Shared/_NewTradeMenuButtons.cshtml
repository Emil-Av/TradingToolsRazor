@using global::Shared

<link rel="stylesheet" href="~/css/select-dropdown-styled.css" />

<!-- Menu Time Frame -->
<div class="col-auto p-2">
    <select class="select-dropdown-styled" id="selectTimeFrame" data-menu-type="timeFrame">
        <option value="" selected disabled>Time Frame: </option>
        @foreach (TimeFrame timeFrame in Enum.GetValues(typeof(TimeFrame)))
        {
            <option value="@((int)timeFrame)">Time Frame: @MyEnumConverter.TimeFrameFromEnum(timeFrame)</option>
        }
    </select>
</div>

<!-- Menu Strategy -->
<div class="col-auto p-2">
    <select class="select-dropdown-styled" id="selectStrategy" data-menu-type="strategy">
        <option value="" selected disabled>Strategy: </option>
        @foreach (Strategy strategy in Enum.GetValues(typeof(Strategy)))
        {
            if (strategy != Strategy.SRS && strategy != Strategy.Espresso)
            {
                continue;
            }

            <option value="@((int)strategy)">Strategy: @MyEnumConverter.StrategyFromEnum(strategy)</option>
        }
    </select>
</div>

<!-- Menu Sample Size Type -->
<div class="col-auto p-2">
    <select class="select-dropdown-styled" id="selectSampleSizeType" data-menu-type="sampleSizeType">
        <option value="" selected disabled>Type: </option>
        @foreach (SampleSizeType sampleSizeType in Enum.GetValues(typeof(SampleSizeType)))
        {
            <option value="@((int)sampleSizeType)">Type: @MyEnumConverter.TradeTypeFromEnum(sampleSizeType)</option>
        }
    </select>
</div>
