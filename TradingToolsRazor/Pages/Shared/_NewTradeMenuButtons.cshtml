@using global::Shared

<style>
    .select-dropdown-styled {
        appearance: none;
        -webkit-appearance: none;
        -moz-appearance: none;
        background-color: #4e73df;
        color: #fff;
        border: 1px solid #4e73df;
        border-radius: 0.35rem;
        padding: 0.375rem 2rem 0.375rem 0.75rem;
        font-size: 1rem;
        font-weight: 400;
        line-height: 1.5;
        cursor: pointer;
        background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' width='4' height='5' viewBox='0 0 4 5'%3e%3cpath fill='%23fff' d='M2 0L0 2h4zm0 5L0 3h4z'/%3e%3c/svg%3e");
        background-repeat: no-repeat;
        background-position: right 0.75rem center;
        background-size: 8px 10px;
        transition: color 0.15s ease-in-out, background-color 0.15s ease-in-out, border-color 0.15s ease-in-out, box-shadow 0.15s ease-in-out;
    }

    .select-dropdown-styled:hover {
        background-color: #2e59d9;
        border-color: #2653d4;
    }

    .select-dropdown-styled:focus {
        background-color: #2e59d9;
        border-color: #2653d4;
        outline: 0;
        box-shadow: 0 0 0 0.2rem rgba(105, 136, 228, 0.5);
    }

    .select-dropdown-styled option {
        background-color: #fff;
        color: #3a3b45;
    }
</style>

<!-- Menu Time Frame -->
<div class="col-auto p-2">
    <select class="select-dropdown-styled" id="selectTimeFrame" data-menu-type="timeFrame">
        <option value="" selected disabled>Time Frame: </option>
        @foreach (ETimeFrame timeFrame in Enum.GetValues(typeof(ETimeFrame)))
        {
            <option value="@((int)timeFrame)">Time Frame: @MyEnumConverter.TimeFrameFromEnum(timeFrame)</option>
        }
    </select>
</div>

<!-- Menu Strategy -->
<div class="col-auto p-2">
    <select class="select-dropdown-styled" id="selectStrategy" data-menu-type="strategy">
        <option value="" selected disabled>Strategy: </option>
        @foreach (EStrategy strategy in Enum.GetValues(typeof(EStrategy)))
        {
            <option value="@((int)strategy)">Strategy: @MyEnumConverter.StrategyFromEnum(strategy)</option>
        }
    </select>
</div>

<!-- Menu Trade Type -->
<div class="col-auto p-2">
    <select class="select-dropdown-styled" id="selectTradeType" data-menu-type="tradeType">
        <option value="" selected disabled>Type: </option>
        @foreach (ETradeType tradeType in Enum.GetValues(typeof(ETradeType)))
        {
            <option value="@((int)tradeType)">Type: @MyEnumConverter.TradeTypeFromEnum(tradeType)</option>
        }
    </select>
</div>

