@model TradingToolsRazor.Pages.Trades.IndexModel
@using SharedEnums.Enums
@using global::Shared

<link rel="stylesheet" href="~/css/select-dropdown-styled.css" />

<!-- Dropdown Menus -->
<div class="container mb-4">
    <div class="row justify-content-center">
        <div class="col-12 col-md-auto d-flex align-items-center flex-wrap justify-content-center">

            <!-- Strategy Menu -->
            <div class="col-auto p-2">
                <select class="select-dropdown-styled" id="selectStrategy" data-menu-type="strategy">
                    @foreach (var strategy in Model.TradesVM.AvailableStrategies)
                    {
                        <option value="@((int)strategy)" selected="@(strategy == Model.TradesVM.CurrentSampleSize.Strategy)">Strategy: @MyEnumConverter.StrategyFromEnum(strategy)</option>
                    }
                </select>
            </div>

            <!-- Trade Type Menu -->
            <div class="col-auto p-2">
                <select class="select-dropdown-styled" id="selectTradeType" data-menu-type="tradeType">
                    @foreach (ETradeType tradeType in Enum.GetValues<ETradeType>())
                    {
                        <option value="@((int)tradeType)" selected="@(tradeType == Model.TradesVM.CurrentTrade.SampleSize?.TradeType)">Type: @MyEnumConverter.TradeTypeFromEnum(tradeType)</option>
                    }
                </select>
            </div>

            <!-- Status Menu -->
            <div class="col-auto p-2">
                <select class="select-dropdown-styled" id="selectStatus" data-menu-type="status">
                    @foreach (EStatus status in Enum.GetValues<EStatus>())
                    {
                        <option value="@((int)status)" selected="@(status == Model.TradesVM.DefaultTradeStatus)">Status: @status</option>
                    }
                </select>
            </div>

            <!-- Time Frame Menu -->
            <div class="col-auto p-2">
                <select class="select-dropdown-styled" id="selectTimeFrame" data-menu-type="timeFrame">
                    @foreach (var tf in Model.TradesVM.AvailableTimeframes)
                    {
                        <option value="@((int)tf)" selected="@(tf == Model.TradesVM.CurrentSampleSize.TimeFrame)">Time Frame: @MyEnumConverter.TimeFrameFromEnum(tf)</option>
                    }
                </select>
            </div>

            <!-- Sample Size Menu -->
            <div class="col-auto p-2">
                <select class="select-dropdown-styled" id="selectSampleSize" data-menu-type="sampleSize">
                    @for (int i = 1; i <= Model.TradesVM.NumberSampleSizes; i++)
                    {
                        <option value="@i" selected="@(i == Model.TradesVM.CurrentSampleSizeNumber)">Sample Size: @i</option>
                    }
                </select>
            </div>

            <!-- Trade Menu -->
            <div class="col-auto p-2">
                <select class="select-dropdown-styled" id="selectTrade" data-menu-type="trade">
                    @for (int i = 1; i <= Model.TradesVM.TradesInSampleSize; i++)
                    {
                        <option value="@i">Trade: @i</option>
                    }
                </select>
            </div>

        </div>
    </div>
</div>
