@using Models.Trades
@model SRS

<div class="row justify-content-center">
    <div class="text-center">
        <div class="row align-items-center">
            <div class="col mr-md-5 d-flex justify-content-center">
                <div id="researchDataTabHeaders">
                    <ul class="nav nav-tabs" id="srsTabs" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active" id="srsData-tab" data-toggle="tab" data-target="#srsData" type="button" role="tab" aria-controls="srsData" aria-selected="true">SRS Data</button>
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="card-body" id="cardBody">
            <div class="tab-content">
                <div class="tab-pane fade show active tundora text-left" id="srsData" role="tabpanel" aria-labelledby="srsData-tab">

                    <div class="row mb-2">
                        <div class="col-12 col-md-6">
                            <label for="InputCandleType" class="d-block">Candle Type</label>
                            <select class="form-control text-center" id="InputCandleType" data-research-data="CandleType"
                                    asp-for="CandleType"
                                    asp-items="Html.GetEnumSelectList<SharedEnums.Enums.ECandleType>()">
                            </select>
                        </div>

                        <div class="col-12 col-md-6">
                            <label for="InputIsInOverNightRange" class="d-block">Is In Over Night Range</label>
                            <select class="form-control text-center" id="InputIsInOverNightRange" data-research-data="IsInOverNightRange" asp-for="IsInOverNightRange">
                                <option value="true">Yes</option>
                                <option value="false">No</option>
                            </select>
                        </div>

                        <div class="col-12 col-md-6">
                            <label for="InputFlippedTheSwitch" class="d-block">Flipped The Switch</label>
                            <select class="form-control text-center" id="InputFlippedTheSwitch" data-research-data="IsFlippedTheSwitch" asp-for="IsFlippedTheSwitch">
                                <option value="true">Yes</option>
                                <option value="false">No</option>
                            </select>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>
